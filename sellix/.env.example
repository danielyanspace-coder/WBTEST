# ─── SELLIX · переменные окружения ───────────────────────────────
# Скопируйте этот файл в .env и заполните значения.

# Приложение
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# База данных (PostgreSQL + pgvector для RAG). Подключается на этапе бэкенда.
DATABASE_URL=postgresql://sellix:sellix@localhost:5432/sellix

# Авторизация (next-auth). Сгенерируйте: openssl rand -base64 32
AUTH_SECRET=change_me

# AI: OpenAI + RAG (выбрано в проекте)
OPENAI_API_KEY=sk-...
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

# Шифрование ключей WB API пользователей (любая длинная случайная строка)
WB_KEY_ENCRYPTION_SECRET=change_me

# Секрет для загрузки справочника в RAG (POST /api/admin/ingest)
ADMIN_SECRET=change_me

# Платежи (сейчас mock; перед продом — ЮKassa)
PAYMENTS_PROVIDER=mock
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Реферальная программа
REFERRAL_PERCENT=20
TRIAL_DAYS=7
